{
  "name": "@cosmosh/renderer",
  "version": "0.1.0+116",
  "private": true,
  "type": "module",
  "description": "Cosmosh Renderer Process (Vite + React)",
  "scripts": {
    "predev": "pnpm --filter @cosmosh/api-contract build && pnpm --filter @cosmosh/i18n build && pnpm theme:sync",
    "dev": "vite",
    "prebuild": "pnpm --filter @cosmosh/api-contract build && pnpm --filter @cosmosh/i18n build && pnpm theme:sync",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "test:oobe": "tsx --test src/lib/oobe.test.ts",
    "test:ssh": "tsx --test src/pages/ssh/ssh-command-markers.test.ts src/pages/ssh/ssh-pane-state.test.ts src/pages/ssh/ssh-utils.test.ts src/pages/ssh/terminal-command-timeline-state.test.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "theme:sync": "node ./scripts/sync-theme.cjs"
  },
